# 服务端口
PORT=8081

# MySQL DSN（默认连接本机 root 无密码，库名 chord）
# 首次启动前请先执行: CREATE DATABASE chord CHARACTER SET utf8mb4;
DB_DSN=root:@tcp(127.0.0.1:3306)/chord?charset=utf8mb4&parseTime=True&loc=Local

# Redis 地址；留空 = 单实例模式（进程内事件总线与在线状态）
REDIS_ADDR=

# JWT 密钥；留空则自动生成并保存到 .data/jwt_secret
JWT_SECRET=

# 空库时自动写入演示数据（alice/bob/carol，密码 123456）
SEED_DEMO=true

# 允许的前端来源（逗号分隔可写多个，默认含 localhost:3000）
CLIENT_ORIGIN=http://localhost:3000
